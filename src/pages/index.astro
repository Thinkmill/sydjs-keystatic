---
import { getEntry } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import EventCard from '@/components/EventCard.astro'
import Button from '@/components/Button.astro'
import AtlassianLogo from '@/components/svg-logos/atlassian.astro'
import ThinkmillLogo from '@/components/svg-logos/thinkmill.astro'
import LookaheadLogo from '@/components/svg-logos/lookahead.astro'
import SkewImage from '@/components/SkewImage.astro'
import { assetPath, sitePath } from '@/lib/paths'
import { getEvents } from '@/lib/get-data'

const admin = await getEntry('admin', 'index')
const { pastEvents, nextEvent } = await getEvents()
---

<Layout>
  <div class="w-full overflow-x-hidden">
    <div class="relative mx-auto grid max-w-6xl px-6 lg:grid-cols-2 lg:pl-8 lg:pr-0">
      <div class="py-8 lg:py-40">
        <h1 class="text-5xl font-bold sm:text-6xl">
          {admin?.data.homepageTitle}
        </h1>
        <p class="mt-6 text-2xl font-medium">
          {admin?.data.homepageDescription}
        </p>
        <p class="mt-10 text-lg">Thanks to our long standing sponsors:</p>
        <ul class="mt-6 flex flex-wrap items-center gap-4 lg:justify-between">
          <li>
            <a
              aria-label="Atlassian (Opens in new tab)"
              class="transition-opacity hover:opacity-50"
              href="https://www.atlassian.com/"
              target="_blank"
              rel="noopener"
            >
              <AtlassianLogo />
            </a>
          </li>
          <li class="h-6 w-px bg-gray-200"></li>
          <li>
            <a
              aria-label="Thinkmill (Opens in new tab)"
              class="transition-opacity hover:opacity-50"
              href="https://www.thinkmill.com.au/"
              target="_blank"
              rel="noopener"
            >
              <ThinkmillLogo />
            </a>
          </li>
          <li class="h-6 w-px bg-gray-200"></li>
          <li>
            <a
              aria-label="Lookahead (Opens in new tab)"
              class="transition-opacity hover:opacity-50"
              href="https://lookahead.com.au/"
              target="_blank"
              rel="noopener"
            >
              <LookaheadLogo />
            </a>
          </li>
        </ul>
      </div>
      <div class="mb-8 flex items-center justify-center md:mb-12 lg:mb-0">
        <div class="grid w-full max-w-2xl grid-rows-[2fr,_4fr,_3fr] justify-items-center lg:max-w-3xl">
          <div class="col-start-1 row-start-2 row-end-4 w-full self-end px-[min(22vw,180px)] lg:px-[8.5rem]">
            <SkewImage
              src={assetPath('/images/speaker.png')}
              maskId="bottom"
              alt="A speaker presenting at a conference"
              viewBox="0 0 304 306"
              path="M254.814 191.328C295.817 95.2743 316.318 47.2472 293.68 18.6781C292.642 17.3679 291.55 16.1007 290.408 14.8798C265.51 -11.7426 214.975 1.41432 113.905 27.7281V27.7281C80.8296 36.3392 64.2921 40.6448 52.6871 51.9286C52.1101 52.4893 51.5447 53.0614 50.9905 53.6445C39.8388 65.3766 35.7209 81.9618 27.4849 115.132L21.7603 138.188C0.885905 222.26 -9.55129 264.296 11.9392 288.431C13.8586 290.587 15.928 292.604 18.1319 294.468C42.8069 315.335 84.5629 303.829 168.075 280.816V280.816C194.134 273.635 207.164 270.045 217.222 261.783C218.184 260.993 219.121 260.174 220.033 259.327C229.57 250.468 234.876 238.038 245.488 213.177L254.814 191.328Z"
            />
          </div>
          <div class="col-start-1 row-start-1 row-end-3 w-full">
            <SkewImage
              src={assetPath('/images/crowd.png')}
              alt="A group of people at a conference"
              maskId="top"
              viewBox="0 0 551 406"
              path="M265.413 38.1947L374.23 66.1498C410.613 75.4966 428.805 80.1701 442.953 91.5132C443.611 92.0406 444.26 92.5777 444.902 93.1246C458.703 104.888 466.713 121.876 482.734 155.853C539.022 275.229 567.166 334.916 540.175 374.66C539.017 376.364 537.797 378.026 536.518 379.641C506.684 417.297 441.307 408.324 310.552 390.377L203.935 375.743C157.935 369.43 134.936 366.273 117.33 352.879C99.7242 339.486 90.5448 318.162 72.1862 275.515L68.8789 267.833C9.85883 130.73 -19.6512 62.1787 14.452 22.3313C48.555 -17.5162 120.841 1.05411 265.413 38.1947Z"
            />
          </div>
        </div>
      </div>
    </div>
    <div class="mx-auto max-w-7xl px-6">
      {nextEvent && <EventCard slug={nextEvent.slug} />}
    </div>
    <div class="mx-auto mt-20 max-w-6xl px-6 lg:px-8">
      <div class="-mr-6 flex items-center justify-between">
        <h2 class="text-3xl font-bold">Past events</h2>
        <div class="hidden sm:block">
          <Button href={sitePath('/events/')} emphasis="low">
            View all events
          </Button>
        </div>
      </div>
      <ul class="mt-6 grid gap-8 sm:mt-12 sm:grid-cols-2 lg:grid-cols-3">
        {pastEvents.map((event) => (
          <li>
            <EventCard heading="h3" slug={event.slug} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>
